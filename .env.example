# Variables de entorno para docker-compose maestro
# Copia este fichero a .env y ajusta los valores

# PostgreSQL
POSTGRES_DB=luxstudio
POSTGRES_USER=luxstudio
POSTGRES_PASSWORD=luxstudio-local-only

# Auth (OIDC)
OIDC_ISSUER_URL=http://auth:8080/realms/salvi
OIDC_CLIENT_ID=gateway
OIDC_CLIENT_SECRET=gateway-secret

# Keycloak admin
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Portal común (URLs visibles desde el navegador)
PUBLIC_KEYCLOAK_URL=/keycloak
PUBLIC_KEYCLOAK_CLIENT_ID=portal
PUBLIC_PORTAL_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1
PUBLIC_LUXSTUDIO_URL=http://localhost:5173
PUBLIC_GISVIAL_URL=http://localhost:5174
