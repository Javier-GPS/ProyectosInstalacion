# Configuración de la Aplicación de Cálculo Fotométrico

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=tu-clave-secreta-aqui

# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Archivos
MAX_FILE_SIZE_MB=50
UPLOAD_FOLDER=uploads
DOWNLOAD_FOLDER=downloads
ALLOWED_EXTENSIONS=xlsx,xls

# Asistente IA contextual (opcional; requiere una clave de Anthropic)
ANTHROPIC_API_KEY=

# Cálculo Fotométrico
NORMAS_APLICABLES=CIE,UNE,DIN,ISO
ZONAS_AMBIENTALES_CIE150=E1,E2,E3,E4
PAVIMENTOS_DISPONIBLES=Asfalto,Hormigón,Adoquín

# Email (para futuras funcionalidades)
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=app@example.com
MAIL_PASSWORD=password

# Base de datos (para futuras funcionalidades)
DATABASE_URL=sqlite:///fotometrico.db
