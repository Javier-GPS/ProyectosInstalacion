{
  "realm": "salvi",
  "enabled": true,
  "displayName": "SALVI Lighting",
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "defaultDefaultClientScopes": ["profile", "email", "openid"],
  "clients": [
    {
      "clientId": "gateway",
      "enabled": true,
      "publicClient": false,
      "secret": "gateway-secret",
      "redirectUris": ["http://localhost:80/*"],
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["profile", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access", "microprofile-jwt"]
    },
    {
      "clientId": "luxstudio",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5173/*"],
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "gisvial",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:5174/*"],
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "portal",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost/*", "http://127.0.0.1:3000/*", "http://127.0.0.1/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost", "http://127.0.0.1:3000", "http://127.0.0.1"],
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@salvi.lighting",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "SALVI",
      "credentials": [{"type": "password", "value": "Admin123!", "temporary": false}],
      "realmRoles": ["admin"],
      "requiredActions": []
    }
  ],
  "roles": {
    "realm": [
      {"name": "admin", "description": "Administrator"},
      {"name": "user", "description": "Regular user"}
    ]
  }
}
